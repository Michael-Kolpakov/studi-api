root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
# Strict analyzer mode: analyzer diagnostics are errors by default
dotnet_analyzer_diagnostic.severity = error

# Keep StyleCop enabled globally as errors
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.DocumentationRules.severity = error
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.LayoutRules.severity = error
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.MaintainabilityRules.severity = error
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.NamingRules.severity = error
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.OrderingRules.severity = error
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.ReadabilityRules.severity = error
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.SpacingRules.severity = error
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.SpecialRules.severity = error

# Require explicit object creation: new ClassName() instead of target-typed new()
csharp_style_implicit_object_creation_when_type_is_apparent = false
dotnet_diagnostic.IDE0090.severity = error

# Require braces in blocks statements
csharp_prefer_braces = true
csharp_preserve_single_line_blocks = false
csharp_preserve_single_line_statements = false
dotnet_diagnostic.IDE0011.severity = error
dotnet_diagnostic.IDE0055.severity = none

# Require file-scoped namespace syntax
csharp_style_namespace_declarations = file_scoped
dotnet_diagnostic.IDE0161.severity = error

# Private fields start with underscore
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_diagnostic.SA1309.severity = none

dotnet_naming_style.private_field_style.required_prefix = _
dotnet_naming_style.private_field_style.capitalization = camel_case

dotnet_naming_rule.private_fields_must_be_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_must_be_underscore.style = private_field_style
dotnet_naming_rule.private_fields_must_be_underscore.severity = error

# Сonstants must be PascalCase (start with upper-case letter)
dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.required_modifiers = const

dotnet_naming_style.constants_pascal_style.capitalization = pascal_case

dotnet_naming_rule.constants_must_be_pascal.symbols = constants
dotnet_naming_rule.constants_must_be_pascal.style = constants_pascal_style
dotnet_naming_rule.constants_must_be_pascal.severity = error

# Allow blank line after single-line comments
dotnet_diagnostic.SA1512.severity = none

# Usings must have a corect declaration order
dotnet_diagnostic.SA1200.severity = error
dotnet_diagnostic.SA1208.severity = error
dotnet_diagnostic.SA1210.severity = error

# Whitespace and file-ending requirements.
dotnet_diagnostic.SA1025.severity = error
dotnet_diagnostic.SA1028.severity = error
dotnet_diagnostic.SA1518.severity = error

# Disallow single-line statements/elements
dotnet_diagnostic.SA1501.severity = error
dotnet_diagnostic.SA1502.severity = error

# Disable known noisy/non-actionable diagnostics
dotnet_diagnostic.AD0001.severity = none
dotnet_diagnostic.SA0001.severity = none
dotnet_diagnostic.SA1413.severity = none
dotnet_diagnostic.SA1633.severity = none

# Allowed/suppressed diagnostics by project decision
dotnet_diagnostic.IDE0001.severity = suggestion
dotnet_diagnostic.IDE0007.severity = none
dotnet_diagnostic.IDE0008.severity = none
dotnet_diagnostic.IDE0022.severity = none
dotnet_diagnostic.IDE0028.severity = none
dotnet_diagnostic.IDE0046.severity = none
dotnet_diagnostic.IDE0058.severity = none
dotnet_diagnostic.IDE0060.severity = none
dotnet_diagnostic.IDE0290.severity = none
dotnet_diagnostic.IDE0305.severity = none
dotnet_diagnostic.CA1000.severity = none
dotnet_diagnostic.CA1002.severity = none
dotnet_diagnostic.CA1019.severity = none
dotnet_diagnostic.CA1031.severity = none
dotnet_diagnostic.CA1062.severity = none
dotnet_diagnostic.CA1308.severity = none
dotnet_diagnostic.CA1515.severity = none
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1716.severity = none
dotnet_diagnostic.CA1813.severity = none
dotnet_diagnostic.CA2007.severity = none
dotnet_diagnostic.CA2227.severity = none
dotnet_diagnostic.CS1591.severity = none
dotnet_diagnostic.SA1009.severity = none
dotnet_diagnostic.SA1101.severity = none
dotnet_diagnostic.SA1111.severity = none
dotnet_diagnostic.SA1124.severity = none
dotnet_diagnostic.SA1201.severity = none
dotnet_diagnostic.SA1204.severity = none
dotnet_diagnostic.SA1402.severity = none
dotnet_diagnostic.SA1600.severity = none

[**/Persistence/Migrations/*.cs]
# Exclude EF Core migrations from analyzer checks
generated_code = true
dotnet_diagnostic.IDE0005.severity = none

[Teachio.WebApi/Controllers/**/*.cs]
# Enforce high-quality XML docs for Swagger-facing endpoints
dotnet_diagnostic.SA1600.severity = error
dotnet_diagnostic.SA1611.severity = error
dotnet_diagnostic.SA1615.severity = error
dotnet_diagnostic.SA1629.severity = error
dotnet_diagnostic.SA1642.severity = error
